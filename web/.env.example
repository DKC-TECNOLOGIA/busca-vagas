# CareerOps Web — Variáveis de Ambiente (Exemplo)
# Copie este arquivo para .env.local e preencha com suas credenciais reais.
# NUNCA faça commit de .env.local ou exponha tokens no frontend.

# Neon PostgreSQL (Apenas Backend/Server)
DATABASE_URL=postgresql://usuario:senha@ep-seu-host.us-east-2.aws.neon.tech/careerops?sslmode=require

# Segredo para assinatura dos cookies de sessão (mínimo 32 caracteres aleatórios)
AUTH_SECRET=troque-por-uma-chave-secreta-aleatoria-com-32-ou-mais-caracteres

# Telegram Bot (Apenas Backend/Server)
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_DEFAULT_CHAT_ID=seu_chat_id_aqui

# Caminho raiz dos dados do motor career-ops (opcional; padrão: diretório pai de web/)
CAREER_OPS_ROOT=..
